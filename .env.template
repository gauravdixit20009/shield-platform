# ═══════════════════════════════════════════════════════════
# SHIELD Platform — Environment Variables Template
# Copy to .env and fill all values before running
# NEVER commit the filled .env to version control
# ═══════════════════════════════════════════════════════════

# ─── Security (Generate with: openssl rand -hex 64) ────────
SECRET_KEY=GENERATE_STRONG_KEY_HERE
FIELD_ENCRYPTION_KEY=GENERATE_FERNET_KEY_HERE

# ─── Database ───────────────────────────────────────────────
POSTGRES_PASSWORD=STRONG_DB_PASSWORD_HERE

# ─── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE

# ─── MinIO (Evidence Vault) ─────────────────────────────────
MINIO_ACCESS_KEY=STRONG_MINIO_KEY_HERE
MINIO_SECRET_KEY=STRONG_MINIO_SECRET_HERE

# ─── Keycloak (Enterprise Auth) ─────────────────────────────
KEYCLOAK_CLIENT_SECRET=KEYCLOAK_SECRET_HERE

# ─── Application ────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=https://shield.gov.in,https://app.shield.gov.in
